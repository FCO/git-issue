#!/bin/bash

ls() {
	local status="open"
	local porcelain=0
	local sort_mode=""
	local prio_gt=""
	local prio_lt=""
	local prio_eq=""
	local tag_filter=""

	while [ $# -gt 0 ]; do
		case "$1" in
			--all) status=""; shift ;;
			--open) status="open"; shift ;;
			--closed) status="closed"; shift ;;
			--porcelain) porcelain=1; shift ;;
			--sort)
				[ $# -ge 2 ] || { echo "git-issue: option '--sort' requires an argument" >&2; return 2; }
				sort_mode="$2"; shift 2 ;;
			--priority-gt)
				[ $# -ge 2 ] || { echo "git-issue: option '--priority-gt' requires an argument" >&2; return 2; }
				prio_gt="$2"; shift 2 ;;
			--priority-lt)
				[ $# -ge 2 ] || { echo "git-issue: option '--priority-lt' requires an argument" >&2; return 2; }
				prio_lt="$2"; shift 2 ;;
			--priority)
				[ $# -ge 2 ] || { echo "git-issue: option '--priority' requires an argument" >&2; return 2; }
				prio_eq="$2"; shift 2 ;;
			--tag)
				[ $# -ge 2 ] || { echo "git-issue: option '--tag' requires an argument" >&2; return 2; }
				tag_filter="$2"; shift 2 ;;
			-*) echo "git-issue: unknown option: $1" >&2; return 2 ;;
			*) status="$1"; shift ;;
		esac
	done

	if [ -z "$sort_mode" ]; then
		sort_mode=$(config_get sort)
		[ -z "$sort_mode" ] && sort_mode="date"
	fi
	case "$sort_mode" in
		date|priority) ;;
		*) echo "git-issue: unknown sort: $sort_mode" >&2; return 2 ;;
	esac

	local tmp
	tmp=$(mktemp)
	git for-each-ref --format="%(refname)" refs/issues/ | while read ref; do
		[ -z "$ref" ] && continue
		local id="${ref##*/}"
		local key
		if [ "$sort_mode" = "priority" ]; then
			key=$(git show "$ref:priority" 2>/dev/null || echo 0)
		else
			key=$(git log --pretty=format:"%ct" "$id" 2>/dev/null | tail -1)
			[ -z "$key" ] && key=0
		fi
		printf '%s\t%s\n' "$key" "$ref" >> "$tmp"
	done

	if [ "$sort_mode" = "priority" ]; then
		sort -k1,1nr "$tmp"
	else
		sort -k1,1n "$tmp"
	fi | while read key ref; do
		[ -z "$ref" ] && continue
		local id="${ref##*/}"
		local title curr_status prio tags
		title=$(git show "$ref:title" 2>/dev/null)
		curr_status=$(git show "$ref:status" 2>/dev/null)
		prio=$(git show "$ref:priority" 2>/dev/null || echo 0)
		tags=$(git show "$ref:tags" 2>/dev/null)

		if [ -n "$status" ] && [ "$curr_status" != "$status" ]; then
			continue
		fi
		if [ -n "$prio_gt" ] && ! [ "$prio" -gt "$prio_gt" ] 2>/dev/null; then
			continue
		fi
		if [ -n "$prio_lt" ] && ! [ "$prio" -lt "$prio_lt" ] 2>/dev/null; then
			continue
		fi
		if [ -n "$prio_eq" ] && [ "$prio" != "$prio_eq" ]; then
			continue
		fi
		if [ -n "$tag_filter" ]; then
			local filter negate
			filter="$tag_filter"
			negate=0
			case "$filter" in
				'!'*) negate=1; filter="${filter#!}" ;;
			esac
			if printf '%s\n' "$tags" | grep -Fxq "$filter"; then
				[ "$negate" -eq 1 ] && continue
			else
				[ "$negate" -eq 0 ] && continue
			fi
		fi

		if [ "$porcelain" -eq 1 ]; then
			printf "%s|%s|%s|%s\n" "$id" "$curr_status" "$title" "$prio"
		else
			local short
			short=$(git log --pretty=format:%h "$id" 2>/dev/null | tail -1)
			[ -z "$short" ] && short="$id"
			local line
			line="$short - $title"
			if [ -n "$prio" ] && [ "$prio" != "0" ]; then
				line="$line  [P:$prio]"
			fi
			local tags_joined
			tags_joined=$(printf '%s\n' "$tags" | awk 'NR>1{printf ", "} {printf "%s", $0} END{print ""}')
			if [ -n "$tags_joined" ]; then
				line="$line  [$tags_joined]"
			fi
			printf '%s\n' "$line"
		fi
	done
	return 0
}
