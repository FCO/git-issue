fetch() {
	local repo=${1:-origin}
	local issue="${2:-*}"
	local remote_ref="+refs/issues/$issue"
	local local_ref="refs/remote-issues/$issue"

	# --prune drops stale refs/remote-issues/* refs whose source issue was
	# deleted on the remote, so a subsequent pull does not resurrect them.
	local output rc
	output=$(git fetch --prune --atomic "$repo" "$remote_ref:$local_ref" 2>&1)
	rc=$?
	debug "$output"

	local n
	n=$(printf '%s\n' "$output" | grep -E '\-> refs/remote-issues/' | grep -v '\[deleted\]' | wc -l | tr -d ' ')
	echo "fetched $n issue(s)"
	return $rc
}
