#!/bin/bash

edit-msg() {
    local iss_id
    iss_id=$(iss-id "open" "$1")

    local ref="refs/issues/$iss_id"
    git show-ref --verify --quiet "$ref" || die "Not a valid issue id"

    local msg_no=-1
    if [ -z "$2" ]; then
	show "$iss_id"
	echo "Message number: "
	read -r msg_no
    else
	msg_no=$2
    fi
    case "$msg_no" in
	''|*[!0-9]*) die "Message number invalid" ;;
    esac

    local msg_id
    msg_id=$(git ls-tree --name-only "$ref" msgs/ 2>/dev/null | while IFS= read -r name; do
	[ -z "$name" ] && continue
	msg_no=$(( msg_no - 1 ))
	if [ "$msg_no" -eq 0 ]; then
		echo "${name##*/}"
	fi
    done)

    [ -z "$msg_id" ] && die "Message number invalid"

    local message_file=$(mktemp)
    git show "$ref:msgs/$msg_id" > "$message_file" 2>/dev/null

    "${EDITOR:=${VISUAL:-vi}}" "$message_file"
    local sha1_msg=$(git hash-object -w "$message_file")

    local msgs_tree=$(mktemp)
    local name base sha
    while IFS= read -r name; do
	[ -z "$name" ] && continue
	base="${name##*/}"
	[ "$base" = "$msg_id" ] && continue
	sha=$(git rev-parse "$ref:msgs/$base" 2>/dev/null) || continue
	echo "100644 blob $sha	$base"
    done < <(git ls-tree --name-only "$ref" msgs/ 2>/dev/null) > "$msgs_tree"
    echo "100644 blob $sha1_msg	$msg_id" >> "$msgs_tree"

    local sha1_msgs_tree=$(git mktree < "$msgs_tree")

    local tree=$(mktemp)
    git ls-tree "$ref" | grep -v "msgs$" > "$tree"
    echo "040000 tree $sha1_msgs_tree	msgs" >> "$tree"

    local sha1_tree=$(git mktree < "$tree")
    local parent=$(git show-ref --verify --hash "$ref")
    local commit_hash=$(echo "Reply edited: ($msg_id)" | git commit-tree "$sha1_tree" -p "$parent")

    git update-ref "$ref" "$commit_hash"

    echo "$msg_id"
}
